# =========================================================================
# ChainDegree Environment Template (Copy this to .env and change values)
# =========================================================================

# Database Configuration (SQL Server)
MSSQL_SA_PASSWORD=YourStrongPassword123!
MSSQL_PORT=1433
ConnectionStrings__ChainDegree=Server=localhost,1433;Database=ChainDegree;User Id=sa;Password=YourStrongPassword123!;Encrypt=True;TrustServerCertificate=True;

# RabbitMQ Configuration
RabbitMQ__Host=localhost
RabbitMQ__Port=5672
RabbitMQ__Username=guest
RabbitMQ__Password=guest

# Blockchain Configuration (Hyperledger Besu)
Blockchain__Besu__ConfigPath=C:\Your\Path\To\besu\config
Blockchain__Besu__DockerSocketUrl=npipe://./pipe/docker_engine
Blockchain__Besu__RpcUrl=http://localhost:8545
Blockchain__Besu__ContractAddress=0x0000000000000000000000000000000000000000
Blockchain__Besu__SystemPrivateKey=YOUR_LOCAL_BESU_PRIVATE_KEY

# Module Toggles & Providers
Modules__Reputation__Enabled=true
Modules__Authentication__Provider=Mock

# Security & JWT
Jwt__Key=YOUR_LOCAL_STRONG_JWT_SECRET_KEY_MIN_256_BITS
AppPassword__MasterKey=YOUR_LOCAL_MASTER_KEY